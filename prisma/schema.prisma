  created_at               DateTime   @default(now()) @db.Timestamptz(6)
  id_formasi               BigInt
  target                   Decimal    @db.Decimal
  last_edited_at           DateTime   @default(dbgenerated("(now() AT TIME ZONE 'utc'::text)")) @db.Timestamptz(6)
  additional_target_produk Json?      @default("[]")
  bulan                    DateTime?  @db.Date
  target_jenis             Json?
  pg_formasi               pg_formasi @relation(fields: [id_formasi], references: [id], onDelete: Cascade)

  @@schema("public")
}

