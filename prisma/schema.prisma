model pg_tt_keuangan {
  id                  BigInt    @id @default(autoincrement())
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  no_faktur           String
  id_outlet           BigInt
  nama_penagih        String
  no_faktur_penjualan String
  tgl_nota            String
  tgl_jatuh_tempo     String
  nominal_faktur      Decimal   @db.Decimal
  tgl_cetak           String
